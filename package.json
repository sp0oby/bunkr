{
  "name": "bunkr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsx scripts/gen-meta.ts && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "preview": "vite preview",
    "contracts:setup": "cd contracts && forge install --no-git foundry-rs/forge-std OpenZeppelin/openzeppelin-contracts@v5.1.0",
    "contracts:test": "cd contracts && forge test",
    "chain": "anvil --port 8545 --chain-id 31337",
    "deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url local --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80",
    "deploy:testnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url robinhood_testnet --broadcast --interactives 1",
    "server": "tsx server/index.ts",
    "server:test": "tsx server/test/replay.test.ts",
    "meta": "tsx scripts/gen-meta.ts"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "preact": "^10.25.4",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.4",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
